{
  "name": "epayco-sdk-node",
  "version": "1.4.2",
  "description": "Epayco API client for node.js",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write --unsafe .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/epaco/epayco-node.git"
  },
  "keywords": [
    "Epayco",
    "API",
    "payment",
    "gateway"
  ],
  "author": "Epayco <ricardo.saldarriaga@payco.co> (https://epayco.co)",
  "contributors": [
    "Jonathan Aguirre <jaguirre@payco.co>",
    "Jeison Caro <jeison.caro@payco.co>",
    "Ricardo Saldarriaga <ricardo.saldarriaga@payco.co>"
  ],
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.4.5",
    "@types/node": "^18.19.130",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
